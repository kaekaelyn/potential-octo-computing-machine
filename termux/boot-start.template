#!/data/data/com.termux/files/usr/bin/sh
# Termux:Boot entry point — generated by install.sh into
# ~/.termux/boot/start-vamp.sh. Runs once per device boot (Termux:Boot app
# must be installed from F-Droid and granted autostart; see docs/PHONE.md).
#
# Boot scripts don't run as a login shell, so termux-services' own runsvdir
# supervisor may not be up yet — start it if it isn't, then enable/start
# the vamp service under it.
termux-wake-lock

mkdir -p "$HOME/.vamp"
# sv-enable/sv up resolve the bare "vamp" service name through SVDIR, which
# is normally exported by an interactive shell sourcing
# $PREFIX/etc/profile.d/start-services.sh — a boot script is neither, so
# export it directly or every sv* call below fails with "unable to change
# to service directory: file does not exist".
export SVDIR="$PREFIX/var/service"

if ! pgrep -f "runsvdir $SVDIR" >/dev/null 2>&1; then
  runsvdir "$SVDIR" >> "$HOME/.vamp/runsvdir.log" 2>&1 &
fi
sleep 2

# runsvdir rescans periodically rather than reacting to the vamp service
# directory instantly, so `sv up` can fail with "unable to open
# supervise/ok: file does not exist" on the first try even once SVDIR and
# the directory are correct — retry briefly instead of giving up.
rm -f "$SVDIR/vamp/down" 2>/dev/null
i=0
while [ "$i" -lt 8 ]; do
  sv up vamp >/dev/null 2>&1 && break
  sleep 1
  i=$((i + 1))
done
